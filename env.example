# server-monitor 환경 설정
# 새 서버에 적용 시: cp env.example .env && vi .env

# === 서버 정보 ===
SERVER_NAME=""
SERVER_DOMAIN=""
SERVER_IP=""
SERVER_OS="Rocky Linux 9.x"

# === 모니터링 대상 사이트 ===
SITES=""
SITES_INFO=""

# === Linux 모니터 계정 ===
MONITOR_USER="monitor"
MONITOR_PASS=""

# === MariaDB 모니터링 계정 (읽기 전용) ===
DB_MONITOR_USER="monitor_db"
DB_MONITOR_PASS=""
DB_ROOT_PASS=""
DB_NAMES=""

# === Apache Basic Auth ===
HTPASSWD_USER="monitor"
HTPASSWD_PASS=""

# === 포트 ===
NETDATA_PORT=19999
UPTIME_KUMA_PORT=3001
COCKPIT_PORT=9090
SERVER_STATUS_PORT=8401

# === SSL ===
SSL_EMAIL=""

# === 알람 임계값 ===
DISK_WARN=85
DISK_CRIT=95
CPU_WARN=80
CPU_CRIT=95
RAM_WARN=85
RAM_CRIT=95
MARIADB_CONN_WARN=100
MARIADB_CONN_CRIT=150
APACHE_WORKER_WARN=75
APACHE_WORKER_CRIT=90
